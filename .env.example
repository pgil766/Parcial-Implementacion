DB_HOST=localhost
DB_PORT=5432
DB_NAME=racing_league
DB_USERNAME=racing_user
DB_PASSWORD=change-me

# Must be at least 32 characters: HS256 signing requires 256 bits of key material.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Access token lifetime in milliseconds (1 hour).
JWT_EXPIRATION=3600000
# Refresh token lifetime in milliseconds (7 days).
JWT_REFRESH_EXPIRATION=604800000

# Origins allowed to call the API from a browser (React dev server, etc).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

API_BASE_URL=http://localhost:8080
SERVER_PORT=8080
